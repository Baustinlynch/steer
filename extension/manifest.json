{
  "manifest_version": 3,
  "name": "steer",
  "version": "0.1.0",
  "description": "Tracks the time you spend coding with ChatGPT and Claude in the browser, for steer. Prompt text never leaves your computer.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*", "https://claude.ai/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://chatgpt.com/*", "https://claude.ai/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "steer" }
}
